        "//legend-engine/legend-engine-xts-java/legend-engine-xt-javaGeneration-pure",
        "//legend-engine/legend-engine-core/legend-engine-core-pure/legend-engine-pure-code-functions-javaCompiler/legend-engine-pure-runtime-java-extension-compiled-functions-javaCompiler",
        "//legend-pure/legend-pure-dsl/legend-pure-dsl-diagram/legend-pure-m2-dsl-diagram-grammar",
        "//legend-pure/legend-pure-dsl/legend-pure-dsl-graph/legend-pure-m2-dsl-graph-grammar",
        "//legend-pure/legend-pure-dsl/legend-pure-dsl-mapping/legend-pure-m2-dsl-mapping-grammar",
        "//legend-pure/legend-pure-dsl/legend-pure-dsl-path/legend-pure-m2-dsl-path-grammar",
        "//legend-pure/legend-pure-dsl/legend-pure-dsl-store/legend-pure-m2-dsl-store-grammar",
        "//legend-pure/legend-pure-dsl/legend-pure-dsl-tds/legend-pure-m2-dsl-tds-grammar",
        "//legend-pure/legend-pure-store/legend-pure-store-relational/legend-pure-m2-store-relational-grammar",
    ],
    visibility = ["//visibility:public"],
)

legend_java_library(
    name = "legend-engine-pure-functions-javaCompiler-pure",
    pure_repository = "core_external_language_java_compiler",
    pure_generator = ":compiled_metadata_generator",
    srcs = [],
    visibility = ["//visibility:public"],
    deps = [
        ":boot",
        "//legend-pure/legend-pure-core/legend-pure-m3-core",
        "//legend-pure/legend-pure-core/legend-pure-m4",
        "//legend-engine/legend-engine-xts-java/legend-engine-xt-javaGeneration-pure",
        "@legend_maven//:org_eclipse_collections_eclipse_collections",
        "@legend_maven//:org_eclipse_collections_eclipse_collections_api",
    ],
)


load("//legend-pure/legend-pure-core/legend-pure-m3-core:pure.bzl", "pure_compiled_metadata_gen")

pure_compiled_metadata_gen(
    name = "core_external_language_java_compiler_compiled_graph",
    srcs = glob(["src/main/resources/**/*"]),
    out = "core_external_language_java_compiler_compiled_metadata.jar",
    module_name = "core_external_language_java_compiler",
    tool = ":compiled_metadata_generator",
    visibility = ["//visibility:public"],
)

java_import(
    name = "core_external_language_java_compiler_compiled_graph_import",
    jars = [":core_external_language_java_compiler_compiled_metadata.jar"],
    visibility = ["//visibility:public"],
)
