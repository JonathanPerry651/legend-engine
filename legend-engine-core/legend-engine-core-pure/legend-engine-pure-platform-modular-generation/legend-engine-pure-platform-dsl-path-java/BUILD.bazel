)

validated_java_library(
    name = "legend-engine-pure-platform-dsl-path-java",
    srcs = [":platform_dsl_path_java_src"],
    javacopts = [
        "-Xep:IdentityBinaryExpression:OFF",
        "-Xep:ComparableType:OFF",
        "-Xep:IsInstanceIncompatibleType:OFF",
