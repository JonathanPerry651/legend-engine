load("@rules_java//java:defs.bzl", "java_binary", "java_library")

java_library(
    name = "resources",
    resources = glob(["src/main/resources/**/*"]),
    visibility = ["//visibility:public"],
)

java_library(
    name = "resources_generator",
    resources = glob(["src/main/resources/**/*"], exclude = ["**/services/org.finos.legend.pure.runtime.java.compiled.extension.CompiledExtension"]),
    visibility = ["//visibility:public"],
)

java_binary(
    name = "Generator",
    main_class = "org.finos.legend.pure.runtime.java.compiled.generation.orchestrator.JavaCodeGeneration",
    runtime_deps = [
        "//legend-pure/legend-pure-runtime/legend-pure-runtime-java-engine-compiled:legend-pure-runtime-java-engine-compiled",
        "//legend-pure/legend-pure-core/legend-pure-m3-core:legend-pure-m3-core",
        "//legend-pure/legend-pure-core/legend-pure-m4:legend-pure-m4",
        "//legend-engine/legend-engine-core/legend-engine-core-pure/legend-engine-pure-code-functions-unclassified/legend-engine-pure-functions-unclassified-pure",
        "//legend-engine/legend-engine-core/legend-engine-core-pure/legend-engine-pure-code-functions-unclassified/legend-engine-pure-runtime-java-extension-shared-functions-unclassified",
        ":boot",
        "@legend_maven//:org_eclipse_collections_eclipse_collections",
        "@legend_maven//:org_eclipse_collections_eclipse_collections_api",
        "@legend_maven//:commons_codec_commons_codec",
        "@legend_maven//:org_apache_commons_commons_text",
        "@legend_maven//:io_opentracing_opentracing_api",
        "@legend_maven//:io_opentracing_opentracing_util",
    ],
    visibility = ["//visibility:public"],
)

genrule(
    name = "generate_sources",
    outs = ["compiled_functions_unclassified_src.srcjar"],
    cmd = """
        mkdir -p work_dir/classes
        mkdir -p work_dir/target

        $(location :Generator) \
            core_functions_unclassified \
            work_dir/classes \
            work_dir/target

        if [ -d work_dir/target/generated-sources ]; then
             cd work_dir/target/generated-sources
             zip -q -r ../../../$(location compiled_functions_unclassified_src.srcjar) .
             cd ../../..
        elif [ -d work_dir/target/generated-test-sources ]; then
             cd work_dir/target/generated-test-sources
             zip -q -r ../../../$(location compiled_functions_unclassified_src.srcjar) .
             cd ../../..
        else
             echo "No sources generated"
             ls -R work_dir
             exit 1
        fi
    """,
    tools = [":Generator"],
    visibility = ["//visibility:public"],
)


java_library(
    name = "boot",
    srcs = glob(["src/main/java/**/*.java"]),
    resources = glob(["src/main/resources/**/*"]),
    deps = [
        "//legend-pure/legend-pure-runtime/legend-pure-runtime-java-engine-compiled:legend-pure-runtime-java-engine-compiled",
        "//legend-pure/legend-pure-core/legend-pure-m3-core:legend-pure-m3-core",
        "//legend-pure/legend-pure-core/legend-pure-m4:legend-pure-m4",
        "//legend-engine/legend-engine-core/legend-engine-core-pure/legend-engine-pure-code-functions-unclassified/legend-engine-pure-functions-unclassified-pure",
        "//legend-engine/legend-engine-core/legend-engine-core-pure/legend-engine-pure-code-functions-unclassified/legend-engine-pure-runtime-java-extension-shared-functions-unclassified",
        "@legend_maven//:org_eclipse_collections_eclipse_collections",
        "@legend_maven//:org_eclipse_collections_eclipse_collections_api",
        "@legend_maven//:commons_codec_commons_codec",
        "@legend_maven//:org_apache_commons_commons_text",
        "@legend_maven//:io_opentracing_opentracing_api",
        "@legend_maven//:io_opentracing_opentracing_util",
    ],
    visibility = ["//visibility:public"],
)

java_library(
    name = "legend-engine-pure-runtime-java-extension-compiled-functions-unclassified",
    srcs = [":compiled_functions_unclassified_src.srcjar"],
    deps = [
        ":boot",
        "//legend-pure/legend-pure-runtime/legend-pure-runtime-java-engine-compiled:legend-pure-runtime-java-engine-compiled",
        "//legend-pure/legend-pure-core/legend-pure-m3-core:legend-pure-m3-core",
        "//legend-pure/legend-pure-core/legend-pure-m4:legend-pure-m4",
        "//legend-engine/legend-engine-core/legend-engine-core-pure/legend-engine-pure-code-functions-unclassified/legend-engine-pure-functions-unclassified-pure",
        "//legend-engine/legend-engine-core/legend-engine-core-pure/legend-engine-pure-code-functions-unclassified/legend-engine-pure-runtime-java-extension-shared-functions-unclassified",
        "@legend_maven//:org_eclipse_collections_eclipse_collections",
        "@legend_maven//:org_eclipse_collections_eclipse_collections_api",
        "@legend_maven//:commons_codec_commons_codec",
        "@legend_maven//:org_apache_commons_commons_text",
        "@legend_maven//:io_opentracing_opentracing_api",
        "@legend_maven//:io_opentracing_opentracing_util",
    ],
    exports = [
        ":boot",
    ],
    javacopts = ["-Xep:ComparableType:OFF"],
    visibility = ["//visibility:public"],
)
