load("@rules_java//java:defs.bzl", "java_binary", "java_library")

java_binary(
    name = "Generator",
    main_class = "org.finos.legend.engine.protocol.generation.GenerateMetaClasses",
    runtime_deps = [
        "//legend-engine/legend-engine-xts-protocol-java-generation/legend-engine-protocol-generation",
        "//legend-pure/legend-pure-dsl/legend-pure-dsl-mapping/legend-pure-runtime-java-extension-compiled-dsl-mapping",
        "//legend-pure/legend-pure-dsl/legend-pure-dsl-mapping/legend-pure-m2-dsl-mapping-pure",
        "//legend-pure/legend-pure-dsl/legend-pure-dsl-path/legend-pure-m2-dsl-path-grammar",
    ],
    visibility = ["//visibility:public"],
)

load("//tools/build_rules:pure_generation.bzl", "pure_protocol_generation")

pure_protocol_generation(
    name = "protocol_pure_src",
    src = "src/main/resources/m3.protocol.json",
    tool = ":Generator",
    visibility = ["//visibility:public"],
)

java_library(
    name = "legend-engine-protocol-pure",
    srcs = [":protocol_pure_src.srcjar"],
    resources = glob(["src/main/resources/**/*"]),
    deps = [
        "//legend-engine/legend-engine-core/legend-engine-core-base/legend-engine-core-language-pure/legend-engine-protocol",
        "//legend-engine/legend-engine-core/legend-engine-core-shared/legend-engine-shared-extensions",
        "@legend_maven//:com_fasterxml_jackson_core_jackson_annotations",
        "@legend_maven//:com_fasterxml_jackson_core_jackson_core",
        "@legend_maven//:com_fasterxml_jackson_core_jackson_databind",
        "@legend_maven//:org_eclipse_collections_eclipse_collections",
        "@legend_maven//:org_eclipse_collections_eclipse_collections_api",
        "@legend_maven//:org_mongodb_bson",
        "@legend_maven//:org_slf4j_slf4j_api",
    ],
    visibility = ["//visibility:public"],
)

java_library(
    name = "protocol-pure-v1",
    srcs = glob(["src/main/java/**/*.java"]),
    resources = glob(["src/main/resources/**/*"]),
    deps = [
        "//legend-engine/legend-engine-core/legend-engine-core-base/legend-engine-core-language-pure/legend-engine-protocol",
        "//legend-engine/legend-engine-core/legend-engine-core-shared/legend-engine-shared-extensions",
        "//legend-pure/legend-pure-runtime/legend-pure-runtime-java-engine-compiled:legend-pure-runtime-java-engine-compiled",
        "@legend_maven//:com_fasterxml_jackson_core_jackson_annotations",
        "@legend_maven//:com_fasterxml_jackson_core_jackson_core",
        "@legend_maven//:com_fasterxml_jackson_core_jackson_databind",
        "@legend_maven//:org_eclipse_collections_eclipse_collections",
        "@legend_maven//:org_eclipse_collections_eclipse_collections_api",
        "@legend_maven//:org_mongodb_bson",
        "@legend_maven//:org_slf4j_slf4j_api",
    ],
    visibility = ["//visibility:public"],
)
